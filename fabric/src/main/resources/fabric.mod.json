{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        {
            "name": "${mod_author}",
            "contact": {
                "email": "contact@expecticament.com",
                "homepage": "https://expecticament.com"
            }
        }
    ],
    "contact": {
        "homepage": "https://helpfulcommands.expecticament.com",
        "sources": "https://github.com/expecticament/helpful-commands",
        "issues": "https://github.com/expecticament/helpful-commands/issues"
    },
    "license": "${license}",
    "icon": "assets/${mod_id}/icon.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "com.expecticament.helpfulcommands.HelpfulCommandsFabric"
        ]
    },
    "mixins": [
        "${mod_id}.mixins.json",
        "${mod_id}.fabric.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "minecraft": "~${minecraft_version}",
        "java": ">=${java_version}"
    },
    "custom": {
        "modmenu": {
            "links": {
                "modmenu.wiki": "https://helpfulcommands.expecticament.com",
                "modmenu.kofi": "https://ko-fi.com/expecticament",
                "modmenu.youtube": "https://www.youtube.com/@expecticament",
                "modmenu.curseforge": "https://www.curseforge.com/minecraft/mc-mods/helpful-commands",
                "modmenu.modrinth": "https://modrinth.com/mod/helpful-commands",
                "modmenu.github_releases": "https://github.com/expecticament/helpful-commands/releases"
            }
        }
    }
}
  